# ============================================
# CONFIGURAÇÕES DO FIREBASE APP DISTRIBUTION
# ============================================

# Firebase App ID (extraído do google-services.json — projeto rn-liveness3d)
FIREBASE_APP_ID=1:943099415715:android:fecb32e295f6878c500316

# Firebase CLI Token (obrigatório para CI/CD)
# Gere com: firebase login:ci
FIREBASE_TOKEN=

# Grupo de testers no Firebase App Distribution
FIREBASE_TESTERS_GROUP=mobile-android

# Testers individuais por email (opcional)
# Separados por vírgula: email1@test.com,email2@test.com
FIREBASE_TESTERS=
